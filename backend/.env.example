# PostgreSQL connection string (Prisma format)
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/taysiir_canteen?schema=public

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Server
PORT=5050
NODE_ENV=development

# CORS - your frontend URL(s), comma separated
CLIENT_ORIGIN=http://localhost:5174
